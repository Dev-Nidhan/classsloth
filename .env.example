# Copy this file to .env and fill in only the integrations you use.
# ClassSloth runs in demo mode when Google credentials are absent.
# Never commit .env, client_secret.json, or token files.

# Local model. Inference stays on this machine.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Week boundaries use this clock. "local" follows the computer's timezone.
# An IANA name such as Asia/Kolkata or America/Los_Angeles also works.
CLASSSLOTH_TIMEZONE=local

# Set to 1 only on the public Render demo. It ignores OAuth keys, search keys,
# and audio keys, and it does not call Ollama.
CLASSSLOTH_PUBLIC_DEMO=
CLASSSLOTH_DATA_DIR=./data

# Google Cloud OAuth client. Use a Desktop app client so the localhost
# redirect matches. Enable the Google Classroom API on the same project.
# Leave these blank to use demo/import mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or point at a Desktop client JSON downloaded from Google Cloud.
# The file must stay outside git. A path is enough; do not commit the JSON.
GOOGLE_CLIENT_SECRETS_FILE=

# Optional. Live study-resource search. Saved results still open offline.
SERPAPI_API_KEY=

# Optional. Spoken revision, only when you explicitly request audio.
# Selected text is sent to ElevenLabs. Notes and plans work without this.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
